<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>삼성화재 글로벌운영팀 카드뉴스 - {{ report_date }}</title>
</head>
<body style="margin:0; padding:0; background-color:#F4F5F7; font-family: 'Malgun Gothic', 'Segoe UI', Arial, sans-serif;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F4F5F7;">
<tr>
<td align="center">
<table role="presentation" width="700" cellpadding="0" cellspacing="0" border="0" style="width:700px; max-width:700px; background-color:#FFFFFF;">

  <!-- ===== 헤더 ===== -->
  <tr>
    <td bgcolor="#0F2A4A" style="background-color:#0F2A4A; padding:28px 40px;">
      <div style="color:#FFFFFF; font-size:24px; font-weight:bold; margin-bottom:6px;">삼성화재 글로벌운영팀 카드뉴스</div>
      <div style="color:#C7D6EA; font-size:13px;">{{ report_date }} 생성 · 미국 / 영국·유럽 / 싱가포르 / 베트남 / 인도네시아 / 중국</div>
    </td>
  </tr>

  <!-- ===== 개요(오늘의 핵심 뉴스) 섹션 ===== -->
  <tr>
    <td style="padding:32px 36px 8px 36px;">
      <div style="color:#0F2A4A; font-size:19px; font-weight:bold;">오늘의 핵심 뉴스 한눈에 보기</div>
    </td>
  </tr>

  {% if overview_by_country %}
    {% for country, arts in overview_by_country.items() %}
    <tr>
      <td style="padding:14px 36px 0 36px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td bgcolor="#1B4F91" style="background-color:#1B4F91; color:#FFFFFF; font-size:13px; font-weight:bold; padding:6px 14px; border-radius:4px;">{{ country }}</td>
          </tr>
        </table>
      </td>
    </tr>
    {% for a in arts %}
    <tr>
      <td style="padding:8px 36px 0 36px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td bgcolor="#E7F0FB" style="background-color:#E7F0FB; border-left:4px solid #1B4F91; padding:12px 16px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="color:#F59E0B; font-size:13px; padding-bottom:4px;">{{ "★" * a.importance_stars }}{{ "☆" * (5 - a.importance_stars) }}</td>
                </tr>
                <tr>
                  <td style="color:#0F2A4A; font-size:14px; font-weight:bold; line-height:1.4; padding-bottom:2px;">{{ a.title }}</td>
                </tr>
                {% if a.headline_ko %}
                <tr>
                  <td style="color:#374151; font-size:13px; line-height:1.4;">{{ a.headline_ko }}</td>
                </tr>
                {% endif %}
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>
    {% endfor %}
    {% endfor %}
  {% else %}
    <tr><td style="padding:8px 36px 0 36px; color:#6B7280; font-size:14px;">확인된 핵심 뉴스가 없습니다.</td></tr>
  {% endif %}

  <!-- ===== 현지 정세(정치/경제/사건사고) TOP1 섹션 ===== -->
  <tr>
    <td style="padding:32px 0 0 0;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td bgcolor="#374151" style="background-color:#374151; color:#FFFFFF; font-size:15px; font-weight:bold; padding:12px 36px;">
            국가별 현지 정세 TOP 뉴스 (정치·경제·사건사고)
          </td>
        </tr>
      </table>
    </td>
  </tr>
  {% if local_affairs_top1 %}
    {% for country, a in local_affairs_top1.items() %}
    <tr>
      <td style="padding:14px 36px 0 36px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td bgcolor="#F4F5F7" style="background-color:#F4F5F7; border-left:4px solid #374151; padding:14px 18px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="color:#374151; font-size:13px; font-weight:bold; padding-bottom:4px;">{{ country }} · 현지중요도 {{ a.local_significance }}/5</td>
                </tr>
                <tr>
                  <td style="color:#0F2A4A; font-size:14px; font-weight:bold; line-height:1.4; padding-bottom:2px;">{{ a.title }}</td>
                </tr>
                {% if a.headline_ko %}
                <tr><td style="color:#374151; font-size:13px; line-height:1.4; padding-bottom:4px;">{{ a.headline_ko }}</td></tr>
                {% endif %}
                <tr><td style="color:#1F2937; font-size:13px; line-height:1.6; padding-bottom:4px;">{{ a.summary }}</td></tr>
                <tr><td style="color:#6B7280; font-size:12px;">{{ a.why_notable_locally }} · <a href="{{ a.url }}" target="_blank" style="color:#1B4F91;">원문 보기 →</a></td></tr>
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>
    {% endfor %}
  {% else %}
    <tr><td style="padding:8px 36px 0 36px; color:#6B7280; font-size:14px;">오늘 확인된 특이 정세 뉴스가 없습니다.</td></tr>
  {% endif %}

  <!-- ===== 개요 / 상세 기사 구분 배너 ===== -->
  <tr>
    <td style="padding:32px 0 0 0;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td bgcolor="#0F2A4A" style="background-color:#0F2A4A; color:#FFFFFF; font-size:15px; font-weight:bold; padding:12px 36px;">
            국가별 상세 뉴스
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- ===== 국가별 상세 카드 ===== -->
  {% for country, articles in countries.items() %}
    {% if articles %}
      {% for a in articles %}
      <tr>
        <td style="padding:28px 36px; border-bottom:10px solid #F4F5F7;">

          {% if a.is_samsung_fire_direct %}
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:12px;">
            <tr><td bgcolor="#B91C1C" style="background-color:#B91C1C; color:#FFFFFF; font-size:12px; font-weight:bold; padding:6px 12px; border-radius:12px;">★ 삼성화재 직접 관련</td></tr>
          </table>
          {% endif %}

          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td align="right" style="color:#6B7280; font-size:13px; font-weight:bold;">{{ country }}</td>
            </tr>
          </table>

          <div style="color:#6B7280; font-size:12px; margin-top:8px;">현지 시각: {{ a.local_time_display }}</div>
          <div style="color:#F59E0B; font-size:16px; letter-spacing:1px; margin-top:4px;">{{ "★" * a.importance_stars }}{{ "☆" * (5 - a.importance_stars) }}</div>

          <div style="color:#0F2A4A; font-size:21px; font-weight:bold; line-height:1.35; margin-top:10px;">{{ a.title }}</div>
          {% if a.headline_ko %}<div style="color:#374151; font-size:15px; margin-top:4px;">{{ a.headline_ko }}</div>{% endif %}

          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:16px;">
            <tr>
              <td bgcolor="#E7F0FB" style="background-color:#E7F0FB; border-left:4px solid #1B4F91; padding:16px 18px; color:#1F2937; font-size:15px; line-height:1.7;">
                {{ a.summary }}
              </td>
            </tr>
          </table>

          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:14px;">
            <tr>
              <td bgcolor="#F4F5F7" style="background-color:#F4F5F7; padding:14px 18px; font-size:14px; color:#1F2937;">
                <strong style="color:#1B4F91;">왜 중요한가:</strong> {{ a.why_important }}
              </td>
            </tr>
          </table>

          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:16px; border-top:1px solid #E5E7EB;">
            <tr>
              <td style="padding-top:12px; font-size:12px; color:#6B7280;">출처: {{ a.source_name }}</td>
              <td align="right" style="padding-top:12px; font-size:12px;"><a href="{{ a.url }}" target="_blank" style="color:#1B4F91; text-decoration:none;">원문 보기 →</a></td>
            </tr>
          </table>

        </td>
      </tr>
      {% endfor %}
    {% else %}
      <tr>
        <td style="padding:28px 36px; border-bottom:10px solid #F4F5F7; text-align:center; color:#6B7280; font-size:16px;">
          [{{ country }}] 확인된 뉴스 없음
        </td>
      </tr>
    {% endif %}
  {% endfor %}

</table>
</td>
</tr>
</table>

</body>
</html>
